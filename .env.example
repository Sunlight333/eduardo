# Copie para .env.local e preencha. Todas são opcionais em desenvolvimento.

# Google Tag Manager do site antigo. Deixe vazio em dev/preview para não sujar as métricas.
NEXT_PUBLIC_GTM_ID=GTM-599783W

# Envio dos formulários por e-mail (https://resend.com). Sem a chave, em dev o lead
# é apenas registrado no console; em produção o formulário mostra erro e sugere o WhatsApp.
RESEND_API_KEY=
# Destinatário dos leads (padrão: e-mail de contato em src/content/site.ts).
LEAD_TO_EMAIL=
# Remetente verificado no Resend (o domínio precisa estar validado lá).
LEAD_FROM_EMAIL="Site Eduardo Rodrigues <site@edurodrigues.com.br>"

# Cloudflare Turnstile (anti-spam). Sem as chaves, só o honeypot protege os formulários.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Mostra cursos em rascunho num build de produção (use só em previews para o cliente revisar).
SHOW_DRAFTS=false
